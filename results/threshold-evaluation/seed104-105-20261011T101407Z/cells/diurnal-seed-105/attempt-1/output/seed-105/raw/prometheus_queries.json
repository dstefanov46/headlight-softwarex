{
  "cpu_seconds": "sum by (pod, container) (container_cpu_usage_seconds_total{namespace=\"trainticket\",container!=\"\",pod!=\"\"})",
  "memory_working_set_bytes": "sum by (pod) (container_memory_working_set_bytes{namespace=\"trainticket\",container!=\"\",pod!=\"\"})",
  "pod_count": "count by (deployment) (label_replace(kube_pod_status_ready{namespace=\"trainticket\",condition=\"true\"} == 1, \"deployment\", \"$1\", \"pod\", \"(.+)-[a-z0-9]{5,10}-[a-z0-9]{5}\"))",
  "request_rate": "sum(rate(istio_requests_total{destination_workload_namespace=\"trainticket\"}[60s]))",
  "istio_p95_latency_ms": "histogram_quantile(0.95, sum by (le, destination_workload) (rate(istio_request_duration_milliseconds_bucket{destination_workload_namespace=\"trainticket\"}[60s])))",
  "failure_count": "sum(increase(istio_requests_total{destination_workload_namespace=\"trainticket\",response_code!~\"2..|3..\"}[60s])) or vector(0)"
}
