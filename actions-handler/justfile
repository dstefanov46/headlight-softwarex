default:
  just --list

export IMG := env_var_or_default("IMG", "actions-handler:latest")
export PLATFORMS := "linux/arm64,linux/amd64"

buildx_image:
    # Build and push docker image for the manager for cross-platform support
    # Copy existing Dockerfile and insert --platform=${BUILDPLATFORM} into Dockerfile.cross, and preserve the original Dockerfile
    sed -e '1 s/\(^FROM\)/FROM --platform=\${BUILDPLATFORM\}/; t' -e ' 1,// s//FROM --platform=\${BUILDPLATFORM\}/' Dockerfile > Dockerfile.cross
    docker buildx create --name actions-handler
    docker buildx use actions-handler
    docker buildx build --push --platform=${PLATFORMS} --tag ${IMG} -f Dockerfile.cross .
    docker buildx rm actions-handler
    rm Dockerfile.cross

build_distribution:
  mkdir -p dist
  cd config/host && kustomize edit set image actions-handler=${IMG} && cd -
  kustomize build config/host > dist/host-cluster-install.yaml
  kustomize build config/karmada > dist/karmada-install.yaml

test:
  go test ./... -race -cover
