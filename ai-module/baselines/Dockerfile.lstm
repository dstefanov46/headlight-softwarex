FROM python:3.11-slim

ARG KUBECTL_VERSION=v1.32.0

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl --proto '=https' --tlsv1.2 --fail --show-error --location --remote-name "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod +x kubectl \
    && mv kubectl /usr/local/bin/ \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --only-binary :all: torch==2.3.1 --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --only-binary :all: numpy==1.26.4 requests==2.31.0
COPY ai-module/ai-module/headlight /app/headlight
COPY ai-module/baselines/lstm_autoscaler.py /app/lstm_autoscaler.py
RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

CMD ["python3", "/app/lstm_autoscaler.py"]
