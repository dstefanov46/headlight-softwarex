# Local Kubernetes and Karmada state. These contain credentials and private keys.
.kube/
.karmada/
.karmada-*/
# Endpoint-repair backups include Kubernetes credentials.
results/**/headlight-*.config.before
results/**/campaign-env.sh
.cache/
.config/

# Generated experiment outputs are archived on the paper-results branch so the
# measured campaign can be cloned and analyzed on another machine.
results/**/*debug*/
results/**/*.sqlite
results/**/*.db
results/**/*.prof
results/**/*.trace

# Python caches and virtual environments.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Python packaging/build outputs.
/build/
/dist/
*.egg-info/

# Model and training outputs.
*.pth
*.pt
*.pkl
*.npy
ai-module/ai-module/trained_models/
ai-module/ai-module/feature_history/
ai-module/ai-module/logs/
ai-module/ai-module/nephele/
ai-module/baselines/artifacts/
results/synthetic-headlight-v2/
results/headlight-v2-live/bundle-*/
results/headlight-v2-live/bundle-*.tar.gz

# Logs and temporary files.
*.log
*.tmp
*.swp
*.swo
nohup.out

# IDE/editor state.
.idea/
.vscode/
.claude/

# OS metadata.
.DS_Store
Thumbs.db
