# Protocol and source hashes use LF consistently on every platform.
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Measurement files and frozen inputs must retain their exact archived bytes.
*.csv -text
*.jsonl -text
results/** -text
experiments/assets/** -text
