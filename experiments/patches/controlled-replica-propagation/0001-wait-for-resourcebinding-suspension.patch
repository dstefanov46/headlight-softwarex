+)
+
+func TestScaleOutWaitsForResourceBindingDispatchSuspension(t *testing.T) {
+	scheme := runtime.NewScheme()
+	for name, add := range map[string]func(*runtime.Scheme) error{
+		"apps":   appsv1.AddToScheme,
+		"policy": karmadapolicyv1alpha1.AddToScheme,
+		"work":   karmadaworkv1alpha2.AddToScheme,
+		"crp":    policyv1alpha1.AddToScheme,
+	} {
+		if err := add(scheme); err != nil {
+			t.Fatalf("add %s scheme: %v", name, err)
+		}
+	}
+
+	replicas := int32(2)
+	dep := &appsv1.Deployment{
+		TypeMeta:   metav1.TypeMeta{APIVersion: "apps/v1", Kind: "Deployment"},
+		ObjectMeta: metav1.ObjectMeta{Name: "ts-route", Namespace: "trainticket", UID: types.UID("route-uid")},
+		Spec:       appsv1.DeploymentSpec{Replicas: &replicas},
+		Status:     appsv1.DeploymentStatus{Replicas: 2, UpdatedReplicas: 2, ReadyReplicas: 2, AvailableReplicas: 2},
+	}
+	trueValue := true
+	falseValue := false
+	policy := &karmadapolicyv1alpha1.PropagationPolicy{
+		ObjectMeta: metav1.ObjectMeta{Name: "crp-owned-ts-route", Namespace: "trainticket"},
+		Spec: karmadapolicyv1alpha1.PropagationSpec{
+			Suspension: &karmadapolicyv1alpha1.Suspension{Dispatching: &trueValue},
+			Placement: karmadapolicyv1alpha1.Placement{
+				ReplicaScheduling: &karmadapolicyv1alpha1.ReplicaSchedulingStrategy{
+					WeightPreference: &karmadapolicyv1alpha1.ClusterPreferences{
+						StaticWeightList: []karmadapolicyv1alpha1.StaticClusterWeight{
+							{TargetCluster: karmadapolicyv1alpha1.ClusterAffinity{ClusterNames: []string{"cluster2"}}, Weight: 1},
+							{TargetCluster: karmadapolicyv1alpha1.ClusterAffinity{ClusterNames: []string{"cluster3"}}, Weight: 1},
+						},
+					},
+				},
+			},
+		},
+	}
+	binding := &karmadaworkv1alpha2.ResourceBinding{
+		ObjectMeta: metav1.ObjectMeta{Name: "ts-route-deployment", Namespace: "trainticket", Generation: 7},
+		Spec: karmadaworkv1alpha2.ResourceBindingSpec{
+			Resource: karmadaworkv1alpha2.ObjectReference{
+				APIVersion: "apps/v1", Kind: "Deployment", Namespace: "trainticket", Name: "ts-route", UID: dep.UID,
+			},
+			Suspension: &karmadaworkv1alpha2.Suspension{Suspension: karmadapolicyv1alpha1.Suspension{Dispatching: &falseValue}},
+		},
+		Status: karmadaworkv1alpha2.ResourceBindingStatus{SchedulerObservedGeneration: 7},
+	}
+	crp := &policyv1alpha1.ControlledReplicaPropagation{
+		ObjectMeta: metav1.ObjectMeta{Name: "ts-route", Namespace: "trainticket"},
+		Spec: policyv1alpha1.ControlledReplicaPropagationSpec{
+			Placements: []policyv1alpha1.Placement{
+				{ClusterName: "cluster2", Replicas: 2},
+				{ClusterName: "cluster3", Replicas: 2},
+			},
+		},
+	}
+
+	fakeClient := fake.NewClientBuilder().WithScheme(scheme).WithObjects(dep, policy, binding).Build()
+	reconciler := &ControlledReplicaPropagationReconciler{Client: fakeClient, Scheme: scheme}
+	result, err := reconciler.reconcileMaxUnavailable(context.Background(), 0, crp, dep.DeepCopy(), policy.DeepCopy())
+	if err != nil {
+		t.Fatalf("reconcile before suspension observation: %v", err)
+	}
+	if result.RequeueAfter == 0 {
+		t.Fatal("expected reconciliation to wait for ResourceBinding suspension")
+	}
+	assertReplicas(t, fakeClient, 2)
+
+	currentBinding := &karmadaworkv1alpha2.ResourceBinding{}
+	key := client.ObjectKey{Namespace: binding.Namespace, Name: binding.Name}
+	if err := fakeClient.Get(context.Background(), key, currentBinding); err != nil {
+		t.Fatalf("get binding: %v", err)
+	}
+	currentBinding.Spec.Suspension.Dispatching = &trueValue
+	if err := fakeClient.Update(context.Background(), currentBinding); err != nil {
+		t.Fatalf("update binding: %v", err)
+	}
+
+	currentDep := &appsv1.Deployment{}
+	if err := fakeClient.Get(context.Background(), client.ObjectKeyFromObject(dep), currentDep); err != nil {
+		t.Fatalf("get deployment: %v", err)
+	}
+	currentPolicy := &karmadapolicyv1alpha1.PropagationPolicy{}
+	if err := fakeClient.Get(context.Background(), client.ObjectKeyFromObject(policy), currentPolicy); err != nil {
+		t.Fatalf("get policy: %v", err)
+	}
+	if _, err := reconciler.reconcileMaxUnavailable(context.Background(), 0, crp, currentDep, currentPolicy); err != nil {
+		t.Fatalf("reconcile after suspension observation: %v", err)
+	}
+	assertReplicas(t, fakeClient, 4)
+}
+
+func assertReplicas(t *testing.T, kubeClient client.Client, want int32) {
+	t.Helper()
+	dep := &appsv1.Deployment{}
+	if err := kubeClient.Get(context.Background(), client.ObjectKey{Namespace: "trainticket", Name: "ts-route"}, dep); err != nil {
+		t.Fatalf("get deployment: %v", err)
+	}
+	if dep.Spec.Replicas == nil || *dep.Spec.Replicas != want {
+		t.Fatalf("replicas = %v, want %d", dep.Spec.Replicas, want)
+	}
+}

