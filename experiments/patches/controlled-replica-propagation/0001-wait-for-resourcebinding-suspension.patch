@@ -268,6 +270,23 @@ func (r *ControlledReplicaPropagationReconciler) reconcileMaxUnavailable(
 		return ctrl.Result{Requeue: true}, nil
 	}
 
+	// PropagationPolicy and ResourceBinding reconciliation is asynchronous. Do
+	// not mutate the aggregate Deployment or its placement weights until the
+	// matching ResourceBinding has observed dispatch suspension. Otherwise a
+	// scale-out can briefly dispatch the new aggregate replica count with the
+	// old weights, creating an unintended extra pod in a member cluster.
+	if hasReplicasChanged || hasPlacementsChanged {
+		dispatchingSuspended, err := r.isResourceBindingDispatchingSuspended(ctx, dep)
+		if err != nil {
+			log.Error(err, "Failed to verify ResourceBinding dispatch suspension", "Deployment.Namespace", dep.Namespace, "Deployment.Name", dep.Name)
+			return ctrl.Result{}, err
+		}
+		if !dispatchingSuspended {
+			log.Info("Waiting for ResourceBinding to observe dispatch suspension", "Deployment.Namespace", dep.Namespace, "Deployment.Name", dep.Name)
+			return ctrl.Result{RequeueAfter: time.Second}, nil
+		}
+	}
+
 	// Deployment and propagation policy updates are not atomic.
 	// Because the propagation policy relies on weights, it's possible that,
 	// momentarily, more replicas are created or removed than intended during updates.
@@ -339,6 +358,39 @@ func (r *ControlledReplicaPropagationReconciler) reconcileMaxUnavailable(
 	return ctrl.Result{}, nil
 }
 
+func (r *ControlledReplicaPropagationReconciler) isResourceBindingDispatchingSuspended(
+	ctx context.Context,
+	dep *appsv1.Deployment,
+) (bool, error) {
+	bindings := &karmadaworkv1alpha2.ResourceBindingList{}
+	if err := r.List(ctx, bindings, client.InNamespace(dep.Namespace)); err != nil {
+		return false, errors.Wrap(err, "failed to list ResourceBindings")
+	}
+
+	matched := false
+	for i := range bindings.Items {
+		binding := &bindings.Items[i]
+		resource := binding.Spec.Resource
+		if resource.APIVersion != appsv1.SchemeGroupVersion.String() ||
+			resource.Kind != "Deployment" ||
+			resource.Namespace != dep.Namespace ||
+			resource.Name != dep.Name ||
+			(resource.UID != "" && dep.UID != "" && resource.UID != dep.UID) {
+			continue
+		}
+
+		matched = true
+		if binding.Spec.Suspension == nil ||
+			binding.Spec.Suspension.Dispatching == nil ||
+			!*binding.Spec.Suspension.Dispatching ||
+			binding.Status.SchedulerObservedGeneration < binding.Generation {
+			return false, nil
+		}
+	}
+
+	return matched, nil
+}
+
 func (r *ControlledReplicaPropagationReconciler) patchPlacements(ctx context.Context, policy *karmadapolicyv1alpha1.PropagationPolicy, placements []policyv1alpha1.Placement) error {
 	original := client.MergeFrom(policy.DeepCopy())
 	karmadaPlacements := placementsToKarmadaPlacements(placements)
